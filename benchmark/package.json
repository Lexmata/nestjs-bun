{
  "name": "nestjs-bun-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmark suite for NestJS adapters",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "pnpm build && node dist/run-benchmarks.js",
    "verify": "pnpm build && node dist/verify-benchmarks.js",
    "typecheck": "tsc --noEmit",
    "start:express": "pnpm build && node dist/apps/express-app.js",
    "start:fastify": "pnpm build && node dist/apps/fastify-app.js",
    "start:bun": "pnpm build && bun dist/apps/bun-app.js"
  },
  "dependencies": {
    "@lexmata/nestjs-platform-bun": "file:..",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.0.0",
    "autocannon": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
